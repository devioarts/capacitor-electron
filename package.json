{
  "name": "@devioarts/capacitor-electron",
  "version": "0.3.0",
  "description": "Capacitor platform for Electron — CLI tools and templates",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/shared/types.d.ts",
      "import": "./dist/shared/types.js",
      "require": "./dist/shared/types.cjs"
    },
    "./globals": {
      "types": "./dist/shared/globals.d.ts"
    }
  },
  "types": "./dist/shared/types.d.ts",
  "files": [
    "dist",
    "template-electron.tar.gz"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "clean": "tsx scripts/clean.ts",
    "watch": "tsx watch --clear-screen=false --include \"src/**/*\" --exclude \"src/shared/types.ts\" scripts/build.ts",
    "lint": "npm run eslint && npm run prettier",
    "eslint": "eslint src/cli src/shared scripts tests",
    "prettier": "prettier --check src/cli src/shared scripts tests",
    "fmt": "prettier --write src/cli src/shared scripts tests && npm run eslint -- --fix",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest",
    "pretest:e2e": "tsx tests/e2e/prepare.ts",
    "test:e2e": "playwright test",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release": "npm publish --access public",
    "DISABLED_capacitor:sync:after": "cap-electron sync",
    "DISABLED_capacitor:copy:after": "cap-electron copy",
    "DISABLED_capacitor:update:after": "cap-electron update"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devioarts/capacitor-electron"
  },
  "bin": {
    "cap-electron": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "capacitor": {
    "electron": {
      "binary": "cap-electron",
      "platforms": [
        "electron"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "capacitor",
    "electron",
    "platform"
  ],
  "peerDependencies": {
    "@capacitor/cli": ">=8.0.0"
  },
  "dependencies": {
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.0.0",
    "electron": "43.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.0"
  }
}
